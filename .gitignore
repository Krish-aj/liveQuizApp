# Dependencies (Never commit these, they make your repo massive)
node_modules/
jspm_packages/
web_elements/

# Environment Variables & Secrets (CRITICAL: Keeps passwords/API keys safe)
.env
.env.local
.env.*.local
*.pem
*.key

# Logs (Temporary debugging files)
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Local Databases & Docker (Prevents committing actual database data)
.docker/
data/
db/
*.db
*.sqlite

# Operating System Junk (Auto-generated by your computer)
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db

# IDEs and Code Editors (Personal editor preferences)
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj